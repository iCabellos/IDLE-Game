# ---------------------------------------------------------------------
# IdleRPG environment configuration.
# Copy this file to .env.local (root) before running Phase 0.
# ---------------------------------------------------------------------

# PostgreSQL connection (URI form; the API converts it to Npgsql format).
POSTGRES_URL=postgresql://idlerpg:secret@localhost:5432/idlerpg

# Redis connection (URI form; converted to StackExchange.Redis format).
REDIS_URL=redis://localhost:6379

# Steam Web API key (https://steamcommunity.com/dev/apikey).
STEAM_API_KEY=<tu_key>

# Steam application id of the published game.
STEAM_APP_ID=<tu_app_id>

# Steam publisher key (Steamworks partner backend).
STEAM_PUBLISHER_KEY=<publisher_key>

# Shared secret used to verify Steam inventory webhook signatures (HMAC-SHA256).
STEAM_WEBHOOK_SECRET=<webhook_secret>

# JWT signing secret. MUST be at least 32 random characters.
JWT_SECRET=<min_32_chars_random>

# JWT issuer claim.
JWT_ISSUER=idle-rpg-api

# JWT audience claim.
JWT_AUDIENCE=idle-rpg-client

# Hangfire dashboard basic-auth credentials.
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASS=<password>

# Runtime environment: Development | Staging | Production.
ENVIRONMENT=Development
